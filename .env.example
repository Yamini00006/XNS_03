# ─── Database (Member 3) ──────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/customer_data_platform

# Individual vars (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=customer_data_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_ECHO=false              # Set to true to print SQL queries

# ─── Django (Member 2) ────────────────────────────────────────
SECRET_KEY=changeme-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Celery / Redis (Member 4) ────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── File storage ─────────────────────────────────────────────
UPLOAD_DIR=/app/datasets/input
